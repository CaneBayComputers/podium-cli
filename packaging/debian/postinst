#!/bin/sh
set -e
case "$1" in
    configure)
        # Docker is Recommends, not Depends, so it may genuinely be absent.
        if ! command -v docker >/dev/null 2>&1; then
            echo "podium-cli: Docker was not found. Podium needs it to run anything."
            echo "            Install Docker, then run: podium configure"
        elif [ ! -f /etc/podium-cli/.env ]; then
            echo "podium-cli: installed. Run 'podium configure' once to set up."
        fi
        # An existing /etc/podium-cli/.env is left exactly as it is: it holds the
        # projects dir, VPC subnet and AI settings, and is not ours to rewrite.
        ;;
esac
exit 0
